# Local environment template.
# Copy this file to .env if you want to run the backend or compose stack locally.

DB_PASSWORD=change-me-local-db-password
DB_PASSWORD_TEST=change-me-local-test-password
SPRING_DATASOURCE_URL=jdbc:mysql://petpal-db:3306/petpal-db
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me-local-db-password
JWT_SECRET=change-me-local-jwt-secret
WEATHER_API_URL=https://api.openweathermap.org/data/2.5/weather
WEATHER_API_KEY=change-me-local-weather-key
OPENROUTER_API_URL=https://openrouter.ai/api/v1/completions
OPENROUTER_API_KEY=change-me-local-openrouter-key
OPENROUTER_MODEL=meta-llama/llama-3.2-1b-instruct:free
CORS_ALLOWED_ORIGINS=http://petpal.local,http://localhost:5173,http://localhost:3000,http://localhost:80,http://127.0.0.1:5173,http://127.0.0.1:3000
TEST_PASSWORD=change-me-local-test-password
